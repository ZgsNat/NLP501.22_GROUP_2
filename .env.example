# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ── Agent brain ─────────────────────────────────────────────────────
# Switch the whole agent with one line: openai | anthropic | google | ollama | gateway | claude_code
# claude_code = Claude via the local `claude` CLI on your Claude Code login (no key; uses ANTHROPIC_*_MODEL; dev only,
# subscription rate limits apply and latency/$ are not API numbers)
LLM_PROVIDER=ollama
# Optional: pin a role to a full "<provider>:<model>" spec (wins over LLM_PROVIDER), e.g. mix providers:
#   LLM_REASONING=anthropic:claude-sonnet-5-5
#   LLM_FAST=ollama:qwen3:8b
LLM_REASONING=
LLM_FAST=

# ── Providers: key + default model per role (reasoning = judgement, fast = typed gate decisions) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_FAST_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-pro
GOOGLE_FAST_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FAST_MODEL=qwen3:8b

# Any OpenAI-compatible gateway (third-party key that proxies Claude/GPT/Gemini/...); model names as the gateway expects
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=claude-sonnet-5-5
GATEWAY_FAST_MODEL=claude-haiku-5-5

# ── RAG ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
EMBED_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBED_SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ── Langfuse (self-hosted via `docker compose --profile observability up -d`) ──
# Leave keys empty to disable tracing. The compose file creates the project with these keys.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
LF_ADMIN_EMAIL=admin@local.dev
LF_ADMIN_PASSWORD=change-me-please
